# --- Database ---
# Local SQLite (legacy / offline):
# DATABASE_URL="file:./dev.db"
#
# Supabase Postgres (production target):
# App runtime — transaction pooler (6543):
DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations — session pooler (5432):
DIRECT_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

ADMIN_PASSWORD="change-me"
ADMIN_SECRET="change-me-long-random-string"
CUSTOMER_SESSION_SECRET="change-me-customer-session"
NEXT_PUBLIC_WHATSAPP_NUMBER="84327453536"

# Public site URL (no trailing slash). Required for correct Sitemap / JSON-LD.
# Production: https://sistersflowers.vn
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Auth (browser-safe)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_…"

# Zalo Social login (https://developers.zalo.me) — optional until app exists
# ZALO_APP_ID=
# ZALO_APP_SECRET=

# Transactional SMTP (info@ / orders@)
# MAIL_FROM_INFO=info@sistersflowers.vn
# MAIL_FROM_ORDERS=orders@sistersflowers.vn
# MAIL_STUDIO_INBOX=orders@sistersflowers.vn
# MAIL_PREVIEW_TO=felsendorff@gmail.com,butchi0603@gmail.com
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=orders@sistersflowers.vn
# SMTP_PASS=

# Production auto-deploy webhook (POST /api/deploy). Set the same value in GitHub Actions secrets.
# DEPLOY_SECRET=
# Optional override of deploy script path on the VPS:
# DEPLOY_SCRIPT_PATH=/var/www/sisters-flowers/scripts/deploy-production.sh
