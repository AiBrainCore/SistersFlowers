# --- Database ---
# Local SQLite (legacy / offline):
# DATABASE_URL="file:./dev.db"
#
# Supabase Postgres (production target):
# App runtime — transaction pooler (6543).
# Use connection_limit≥5 so next build / sitemap prerender does not hit Prisma P2024.
# Deploy bumps 1→5 automatically if an old .env still has limit=1.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Migrations — session pooler (5432):
DIRECT_URL="postgresql://postgres.PROJECT_REF:[PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

ADMIN_PASSWORD="change-me"
ADMIN_SECRET="change-me-long-random-string"
CUSTOMER_SESSION_SECRET="change-me-customer-session"
NEXT_PUBLIC_WHATSAPP_NUMBER="84327453536"

# Public site URL (no trailing slash). Required for correct Sitemap / JSON-LD.
# Production: https://sistersflowers.vn
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Tag Manager (browser). Default in code: GTM-W8CLFD5Z. Set empty to disable.
# NEXT_PUBLIC_GTM_ID="GTM-W8CLFD5Z"

# Supabase Auth (browser-safe)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_…"
# Server-only — branded signup verify links (never NEXT_PUBLIC_*)
# SUPABASE_SERVICE_ROLE_KEY=

# Zalo Social login (https://developers.zalo.me) — optional until app exists
# ZALO_APP_ID=
# ZALO_APP_SECRET=

# --- P.A Vietnam / maychuemail SMTP (server-side only; never NEXT_PUBLIC_*) ---
# Real values live in gitignored secrets/mail.env and VPS .env
# SSL SMTP: mail9234.maychuemail.com:465 (or 587 STARTTLS)
EMAIL_ENABLED=false
SMTP_HOST=mail9234.maychuemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@sistersflowers.vn
# Quote passwords if they contain $ or ! (Node --env-file expands $ otherwise):
SMTP_PASSWORD=
# Alias also accepted by the app:
# SMTP_PASS=

MAIL_FROM=info@sistersflowers.vn
MAIL_FROM_NAME=Sisters Flowers
MAIL_REPLY_TO=info@sistersflowers.vn
MAIL_FROM_INFO=info@sistersflowers.vn
MAIL_STUDIO_INBOX=info@sistersflowers.vn
# Orders mailbox (order emails authenticate as this user when set)
MAIL_FROM_ORDERS=orders@sistersflowers.vn
SMTP_USER_ORDERS=orders@sistersflowers.vn
SMTP_PASSWORD_ORDERS=
# SMTP_PASS_ORDERS=
# Public https origin for logos + CTA inside HTML emails (never localhost)
MAIL_PUBLIC_SITE_URL=https://sistersflowers.vn
# Optional social overrides for email footer icons:
# MAIL_SOCIAL_TIKTOK=https://www.tiktok.com/@sistersflowers.vn
# MAIL_SOCIAL_FACEBOOK=https://www.facebook.com/sistersflowers92
# MAIL_SOCIAL_INSTAGRAM=https://www.instagram.com/sistersflowers.vn/
# MAIL_SOCIAL_WHATSAPP=https://wa.me/84327453536
# MAIL_SOCIAL_ZALO=https://zalo.me/84327453536
# MAIL_UNSUBSCRIBE_SECRET=
# Optional later city overrides (unset = MAIL_STUDIO_INBOX):
# MAIL_STUDIO_INBOX_DALAT=
# MAIL_STUDIO_INBOX_DANANG=
# BCC every outbound system email to these team inboxes (comma-separated):
# MAIL_PREVIEW_TO=felsendorff@gmail.com,butchi0603@gmail.com,dinhlamhung50@gmail.com
# MAIL_BCC_OWNERS=0

# Production auto-deploy webhook (POST /api/deploy). Set the same value in GitHub Actions secrets.
# DEPLOY_SECRET=
# Optional override of deploy script path on the VPS:
# DEPLOY_SCRIPT_PATH=/var/www/sisters-flowers/scripts/deploy-production.sh
