{
  "name": "sisters-flowers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && prisma db seed && NODE_OPTIONS='--max-old-space-size=1536' next build --webpack",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/features/shop-bot/*.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "catalog:import-buckets": "IMPORT_PRODUCT_TYPE=bouquet node scripts/import-catalog-folder.mjs",
    "catalog:import-basket": "IMPORT_PRODUCT_TYPE=flower-basket node scripts/import-catalog-folder.mjs",
    "catalog:import-stand-congrats": "IMPORT_PRODUCT_TYPE=stand-congrats node scripts/import-catalog-folder.mjs",
    "catalog:upright-orient": "node scripts/upright-bouquet-orient.mjs",
    "catalog:seed-attributes": "node scripts/seed-catalog-attributes.mjs",
    "catalog:enrich-ai": "node scripts/enrich-catalog-ai.mjs",
    "journal:seed-v3": "node scripts/seed-journal-v3.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/model-viewer": "^4.4.0",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "isomorphic-dompurify": "^4.7.0",
    "next": "^16.4.5",
    "nodemailer": "^10.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "zod": "4.6.7",
    "minimatch": "11.0.1"
  }
}
