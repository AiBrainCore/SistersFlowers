generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  /// App runtime — prefer Supabase transaction pooler (6543 + pgbouncer=true).
  url       = env("DATABASE_URL")
  /// Migrations / introspect — Supabase session pooler (5432) or direct DB host.
  directUrl = env("DIRECT_URL")
}

model Product {
  id         String            @id @default(cuid())
  slug       String            @unique
  price      Int
  image      String
  accent     String            @default("rose")
  nameEn     String
  nameVi     String
  tagEn      String
  tagVi      String
  blurbEn    String
  blurbVi    String
  storyEn    String
  storyVi    String
  published  Boolean           @default(true)
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  categories ProductCategory[]
  cityStock  ProductCityAvailability[]
}

model Category {
  id        String            @id @default(cuid())
  slug      String            @unique
  nameEn    String
  nameVi    String
  sortOrder Int               @default(0)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  products  ProductCategory[]
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

/// Storefront customer profile (Supabase Auth and/or Zalo).
model Customer {
  id               String   @id @default(cuid())
  /// Supabase auth.users id when signed up via email/Google
  authUserId       String?  @unique
  email            String?
  emailVerifiedAt  DateTime?
  name             String?
  phone            String?
  /// Zalo Social user id
  zaloId           String?  @unique
  preferredLocale  String   @default("vi")
  /// email | google | zalo
  provider         String   @default("email")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orders           Order[]
}

model Order {
  id             String      @id @default(cuid())
  reference      String      @unique
  /// shop = web checkout; studio = staff phone / walk-in intake
  source         String      @default("shop")
  /// Human sale code for studio (e.g. DN-260412-017). Shop keeps reference.
  saleCode       String?     @unique
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  locale         String
  customerName   String
  phone          String
  email          String?
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Stable buyer code when known (e.g. SF-C-00042)
  buyerCode      String?
  zone           String
  deliveryKm     Int?
  deliveryFee    Int?
  address        String
  deliveryDate   String?
  deliveryTime   String?
  /// delivery | pickup
  fulfillment    String      @default("delivery")
  notes          String?
  recipientName  String?
  recipientPhone String?
  /// Handwritten card text
  cardMessage    String?
  hotelName      String?
  roomNumber     String?
  subtotal       Int
  deliveryTotal  Int         @default(0)
  /// unpaid | deposit | paid | cod
  paymentStatus  String      @default("unpaid")
  depositAmount  Int         @default(0)
  status         String      @default("new")
  whatsappUrl    String?
  /// Optimistic concurrency for studio edits
  version        Int         @default(1)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       OrderPayment[]
  media          OrderMedia[]
}

/// Reference photos — preferably per order line item.
model OrderMedia {
  id            String     @id @default(cuid())
  orderId       String
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId   String?
  orderItem     OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  url           String
  mime          String?
  sortOrder     Int        @default(0)
  legacyDriveId String?
  createdAt     DateTime   @default(now())

  @@index([orderId, sortOrder])
  @@index([orderItemId])
}

/// Append-only status / payment gate events for studio + shop orders.
model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus  String
  note      String?
  /// admin | system | staff:<id>
  actor     String   @default("admin")
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/// Payment records (deposit / full / COD mark). QR provider wiring comes later.
model OrderPayment {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// deposit | full | cod | adjustment
  kind      String
  /// vietqr | momo | gateway | cash | transfer | other
  method    String   @default("other")
  amount    Int
  note      String?
  /// When staff confirmed money was seen
  seenAt    DateTime?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  slug               String
  name               String
  price              Int
  qty                Int
  image              String
  kind               String    @default("product")
  note               String?
  partnerName        String?
  commissionPercent  Int?
  commissionAmount   Int?
  /// Money voucher code (partner items only), e.g. SF-V-A1B2C3
  voucherCode        String?   @unique
  /// issued | redeemed | expired
  voucherStatus      String?
  voucherExpiresAt   DateTime?
  redeemedAt         DateTime?
  /// Amount Sisters remits to partner after commission (face value − commission)
  remitAmount        Int?
  media              OrderMedia[]
}

model Inquiry {
  id        String   @id @default(cuid())
  variant   String
  name      String
  email     String
  phone     String?
  date      String?
  message   String
  hotel     String?
  room      String?
  venue     String?
  guests    String?
  /// Active network city slug at inquiry time (e.g. dalat)
  citySlug  String?
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model DeliverySettings {
  id         String   @id @default("default")
  studioName String   @default("Da Lat")
  includedKm Int      @default(8)
  baseFee    Int      @default(30000)
  midKm      Int      @default(20)
  midFee     Int      @default(60000)
  maxKm      Int      @default(45)
  maxFee     Int      @default(120000)
  updatedAt  DateTime @updatedAt
}

model DeliveryZone {
  id        String   @id @default(cuid())
  nameEn    String
  nameVi    String
  km        Int
  quoteOnly Boolean  @default(false)
  noteEn    String   @default("")
  noteVi    String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Addon {
  id                 String   @id @default(cuid())
  slug               String   @unique
  /// extra = teddy/card/chocolate; partner = money voucher (spa/salon/taxi/…)
  kind               String   @default("extra")
  nameEn             String
  nameVi             String
  descriptionEn      String   @default("")
  descriptionVi      String   @default("")
  price              Int
  image              String   @default("")
  requiresNote       Boolean  @default(false)
  partnerName        String   @default("")
  partnerCategory    String   @default("")
  /// Percent commission Sisters earn from partner (0-100)
  commissionPercent  Int      @default(0)
  /// Days the issued voucher code stays valid after purchase
  validityDays       Int      @default(90)
  active             Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// Network city (e.g. Da Lat, Da Nang). Separate from Branch —
/// one city may host multiple Sisters studios later.
model City {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  nameEn      String
  nameVi      String
  /// open | coming_soon | inactive
  status      String                 @default("coming_soon")
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  branches    Branch[]
  products    ProductCityAvailability[]
}

/// Physical Sisters studio / point of fulfilment within a city.
model Branch {
  id        String   @id @default(cuid())
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  slug      String
  nameEn    String
  nameVi    String
  /// open | coming_soon | inactive
  status    String   @default("coming_soon")
  isPrimary Boolean  @default(false)
  addressEn String   @default("")
  addressVi String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@unique([cityId, slug])
}

/// City-level assortment / price override.
/// available=false hides the product in that city; missing row or true = shown.
/// priceOverride null = use Product.price.
model ProductCityAvailability {
  id            String  @id @default(cuid())
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  cityId        String
  city          City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  available     Boolean @default(true)
  priceOverride Int?

  @@unique([productId, cityId])
}

/// Studio journal: tips, stories, news, partnerships (EN/VI, SEO).
model JournalPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  /// tip | story | news | partnership
  kind        String    @default("tip")
  /// both | danang | dalat
  cityScope   String    @default("both")
  titleEn     String
  titleVi     String
  excerptEn   String    @default("")
  excerptVi   String    @default("")
  bodyEn      String    @default("")
  bodyVi      String    @default("")
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([kind])
}

/// Lightweight delivery audit for transactional email (no SMTP secrets).
model EmailDeliveryLog {
  id          String   @id @default(cuid())
  eventKey    String?
  relatedType String?
  relatedId   String?
  toAddress   String
  subject     String
  status      String
  providerId  String?
  error       String?
  createdAt   DateTime @default(now())

  @@index([eventKey])
  @@index([createdAt])
}

/// Addresses that opted out of non-transactional Sisters Flowers email.
model EmailSuppression {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("unsubscribe_link")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
